---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Intro from "../components/Intro.astro";
import LogList from "../components/LogList.astro";
import ArchitectureOverview from "../components/ArchitectureOverview.astro";

const entries = (await getCollection("log")).sort(
  (a: CollectionEntry<"log">, b: CollectionEntry<"log">) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout>
  <Intro total={entries.length} />
  <ArchitectureOverview />
  <section class="shell">
    <div class="head">
      <p class="eyebrow">Latest journal entries</p>
      <a class="tiny" href={base + "/entries"}>All entries →</a>
    </div>
    <LogList entries={entries.slice(0, 3)} />
  </section>
</BaseLayout>

<style>
  .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
</style>
