---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterBar from "../components/FilterBar.astro";
import LogList from "../components/LogList.astro";

const entries = (await getCollection("log")).sort(
  (a: CollectionEntry<"log">, b: CollectionEntry<"log">) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const years: string[] = Array.from(new Set<string>(entries.map((e: CollectionEntry<"log">) => String(e.data.date.getFullYear())))).sort().reverse();
const groups = [
  { key: "mark" as const, label: "Mark", values: ["I", "II", "III"] },
  { key: "area" as const, label: "Area", values: ["Voice", "Intelligence", "Audio", "Memory", "Tools", "Platform"] },
  { key: "status" as const, label: "Status", values: ["VERIFIED", "ACTIVE", "EXPERIMENTAL", "NEEDS WORK", "SUPERSEDED", "RETIRED"] },
  { key: "date" as const, label: "Year", values: years },
];
---

<BaseLayout title="Journal" description="The M.A.R.K. engineering journal, filterable by generation, area, status, and year.">
  <section class="shell head">
    <p class="eyebrow">Journal</p>
    <h1>What changed, what survived, and what the evidence says.</h1>
    <p class="muted lede">The System page describes what is true now. This journal records what was built, tested, learned, replaced, or disproven over time.</p>
  </section>
  <section class="shell body">
    <FilterBar groups={groups} />
    <div class="gap"><LogList entries={entries} filterable showMark /></div>
  </section>
</BaseLayout>

<style>
  .head{padding:40px 0 0}
  h1{margin-top:12px}
  .lede{margin-top:12px;max-width:var(--measure)}
  .body{padding-top:24px}
  .gap{margin-top:16px}
  @media (max-width:640px){.head{padding-top:24px}}
</style>
