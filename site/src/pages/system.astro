---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubsystemTable from "../components/SubsystemTable.astro";
import HostTable from "../components/HostTable.astro";
import ArchitectureOverview from "../components/ArchitectureOverview.astro";
import DiagramGallery from "../components/DiagramGallery.astro";
---

<BaseLayout title="System" description="Repositories, signal path, and host support for M.A.R.K. II.">
  <section class="shell head">
    <p class="eyebrow">System</p>
    <h1>What exists, what is active, and who owns it.</h1>
    <p class="muted lede">
      M.A.R.K. II is an intelligent half-duplex assistant. Independent cores communicate through
      typed boundaries, while assistant-runtime composes the running system without owning the cores.
    </p>
  </section>
  <ArchitectureOverview />
  <DiagramGallery />
  <SubsystemTable />
  <HostTable />
</BaseLayout>

<style>
  .head{padding:56px 0 8px}
  h1{margin-top:12px;max-width:22ch}
  .lede{margin-top:12px;max-width:var(--measure)}
  @media (min-width:641px) and (max-width:900px){.head{padding:40px 0 8px}}
  @media (max-width:640px){.head{padding:24px 0 0}}
</style>
