---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubsystemTable from "../components/SubsystemTable.astro";
import HostTable from "../components/HostTable.astro";
import SignalPath from "../components/SignalPath.astro";
---

<BaseLayout title="System" description="Repositories, signal path, and host support for M.A.R.K. II.">
  <section class="shell head">
    <p class="eyebrow">System</p>
    <h1>What exists, and what it owns.</h1>
    <p class="muted lede">
      The cores have zero imports between each other. assistant-runtime is the composition root: it
      connects public boundaries through typed adapters without merging the ownership of the cores.
    </p>
  </section>
  <div class="signal"><SignalPath /></div>
  <SubsystemTable />
  <HostTable />
</BaseLayout>

<style>
  .head{padding:56px 0 8px}
  h1{margin-top:12px;max-width:22ch}
  .lede{margin-top:12px;max-width:var(--measure)}
  @media (max-width:900px){.signal{display:none}}
  @media (min-width:641px) and (max-width:900px){.head{padding:40px 0 8px}}
  @media (max-width:640px){.head{padding:24px 0 0}}
</style>
