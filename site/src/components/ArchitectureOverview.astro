  .live-label{margin-bottom:10px}
  .live-path{display:grid;grid-template-columns:1fr 24px 1fr 24px 1fr 24px 1fr;gap:8px;align-items:center}
  .node{min-height:80px;padding:12px;background:var(--surface-sunken);border:1px solid var(--border-default);border-radius:8px;display:flex;flex-direction:column;gap:5px}
  .node span{font-size:11px;color:var(--text-tertiary)}
  .node strong{font-size:13px;font-weight:500;line-height:1.3}
  .node small,.branch small,.composition-label small{font-size:12px;color:var(--text-tertiary);line-height:1.35}
  .node.boundary{border-style:dashed}
  .node.core{border-color:var(--accent)}
  .arrow{text-align:center;color:var(--text-tertiary)}
