  .adapter-line span{height:1px;background:var(--border-subtle)}
  .composition{padding:16px;background:var(--accent-soft);border:1px solid var(--accent);border-radius:8px}
  .composition-label{display:flex;flex-direction:column;gap:5px}
  .composition-label strong{font-size:14px;font-weight:500}
  .branches{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}
  .branch{display:flex;flex-direction:column;gap:5px;padding:12px;background:var(--surface-card);border:1px solid var(--border-subtle);border-radius:8px}
  .branch strong{font-size:12px;font-weight:500;line-height:1.35}
  .note{margin-top:10px;max-width:var(--measure)}
  @media (min-width:641px) and (max-width:900px){.heading{grid-template-columns:1fr 1fr}.live-path{grid-template-columns:1fr 18px 1fr 18px 1fr 18px 1fr}.branches{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:640px){.architecture{padding-top:28px}.heading{display:block}.explanation{margin-top:12px}.diagram{padding:14px}.live-path{display:flex;flex-direction:column;align-items:stretch}.arrow{transform:rotate(90deg);height:16px}.node{min-height:0}.adapter-line{margin:16px 0 10px}.branches{grid-template-columns:1fr;margin-top:14px}}
</style>
