---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const diagrams = [
  {
    src: "/images/model-4.png",
    label: "Current native path",
    title: "Realtime voice path",
    alt: "Diagram showing microphone, assistant runtime, realtime core, Gemini Live, direct conversation, response audio, and bounded tool calls.",
    caption: "Compact view of the native realtime path. The current assistant-runtime composition uses the realtime core for the live conversation and keeps tool execution behind the Tool System.",
  },
  {
    src: "/images/delegation-architecture.png",
    label: "Hardware-verified slice",
    title: "Delegated voice intelligence",
    alt: "Detailed diagram showing Gemini Live handing work to a delegation broker, intelligence core, tool system, memory core, and delivery scheduler.",
    caption: "Detailed delegation path used by the verified voice-intelligence slice. The diagram is a reference of that path, not a claim that every branch is active in every runtime configuration.",
  },
  {
    src: "/images/delegation-timeline.png",
    label: "Hardware-verified slice",
    title: "Delegation timeline",
    alt: "Timeline diagram showing user audio, Gemini Live acknowledgement, asynchronous delegation, tool and memory work, and delivery back into the same realtime session.",
    caption: "The user can continue speaking while delegated work runs; the result is delivered back into the same realtime session when the scheduler allows it.",
  },
  {
    src: "/images/handoff-compact-mono.png",
    label: "Session handoff",
    title: "Voice session handoff",
    alt: "Monochrome diagram showing session A, transcript, summary, confirmation, and session B during a voice handoff.",
    caption: "A compact handoff model: the original session stays live while the next session is prepared, and the swap happens during silence.",
  },
  {
    src: "/images/model.png",
    label: "Conceptual model",
    title: "Voice model boundary",
    alt: "Conceptual diagram showing a voice model with conversation and delegation branches, then an intelligence core with tools, reasoner, and agents.",
    caption: "Conceptual boundary map for the voice-facing layer. It is useful for orientation, but it is not the authoritative current implementation map.",
  },
  {
    src: "/images/model-2.png",
    label: "Conceptual model",
    title: "M.A.R.K. II composed runtime",
    alt: "Conceptual diagram showing M.A.R.K. II as a composed runtime with intelligence, memory, speech, tool, device, activation, and external system branches.",
    caption: "A broader composition sketch. Planned systems and future boundaries are shown here as design direction, not as shipped capabilities.",
  },
];
---

<section class="shell diagrams" aria-labelledby="diagram-title">
  <div class="head">
    <div>
      <p class="eyebrow">Reference diagrams</p>
      <h2 id="diagram-title">The system in pictures.</h2>
    </div>
    <p class="tiny legend">Current paths are labelled separately from conceptual maps.</p>
  </div>
  <div class="grid">
    {diagrams.map((diagram) => (
      <figure class="card diagram">
        <div class="diagram-meta">
          <span class="eyebrow">{diagram.label}</span>
          <span class="tiny mono">{diagram.title}</span>
        </div>
        <img src={base + diagram.src} alt={diagram.alt} loading="lazy" decoding="async" />
        <figcaption>{diagram.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .diagrams{padding-top:40px}
  .head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:16px}
  h2{margin-top:8px}
  .legend{max-width:30ch;text-align:right}
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .diagram{overflow:hidden}
  .diagram-meta{display:flex;justify-content:space-between;gap:12px;align-items:baseline;padding:14px 16px;border-bottom:1px solid var(--border-subtle)}
  .diagram img{display:block;width:100%;height:auto;background:#08090b}
  figcaption{padding:12px 16px 16px;color:var(--text-secondary);font-size:12px;line-height:1.5}
  @media (max-width:900px){.grid{grid-template-columns:1fr}.legend{max-width:none}}
  @media (max-width:640px){.diagrams{padding-top:28px}.head{display:block}.legend{text-align:left;margin-top:8px}.diagram-meta{display:block}.diagram-meta .tiny{display:block;margin-top:4px}}
</style>
