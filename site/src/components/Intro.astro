---
import { facts, site } from "../data/site";
interface Props { total: number; }
const { total } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="intro">
  <div class="shell">
    <p class="eyebrow">Merely A Responsive Kernel</p>
    <h1>The platform around the assistant.</h1>
    <p class="lede muted">
      M.A.R.K. is model-independent infrastructure for a persistent personal assistant. It is not a
      chatbot, a voice model, a desktop application, or one provider. It is the kernel around those
      components: interaction, memory, state, tools, delegation, and lifecycle.
    </p>
    <div class="generation"><span class="mono">M.A.R.K. II</span><span>Intelligent Half-Duplex Assistant</span></div>
    <div class="actions">
      <a class="cta" href={base + "/system"}>See the current system</a>
      <a class="ghost" href={base + "/entries"}>Read the journal · {total}</a>
      <a class="ghost" href={base + "/marks"}>M.A.R.K. I → II → III</a>
      <a class="ghost" href={site.repo}>Read the source</a>
    </div>
    <dl class="facts">
      {facts.map((x) => (
        <div>
          <dt class="eyebrow">{x.label}</dt>
          <dd class="mono">{x.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .intro{padding:56px 0 32px}
  h1{margin-top:12px;max-width:22ch}
  .lede{margin-top:12px;max-width:var(--measure)}
  .generation{display:flex;gap:10px;align-items:baseline;margin-top:18px;color:var(--text-secondary);font-size:13px}
  .generation .mono{color:var(--text-primary);font-size:12px}
  .actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
  .cta,.ghost{display:inline-flex;align-items:center;height:32px;padding:0 16px;border-radius:999px;font-size:13px;font-weight:500;text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1),transform 150ms}
  .cta{background:var(--surface-inverse);color:var(--text-inverse)}
  .cta:hover{background:var(--gray-600);text-decoration:none}
  .cta:active,.ghost:active{transform:scale(.97)}
  .ghost{background:var(--surface-card);border:1px solid var(--border-default);color:var(--text-primary)}
  .ghost:hover{background:var(--surface-hover);text-decoration:none}
  .facts{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:32px 0 0;padding:0;background:var(--border-subtle);border:1px solid var(--border-subtle);border-radius:16px;overflow:hidden}
  .facts > div{background:var(--surface-card);padding:14px 16px}
  dd{margin:6px 0 0;font-size:14px;color:var(--text-primary)}
  @media (max-width:900px){
    .intro{padding:44px 0 28px}
    .facts{grid-template-columns:repeat(2,1fr)}
    .actions .ghost:last-child{display:none}
  }
  @media (max-width:640px){.intro{padding:28px 0 24px}}
</style>
