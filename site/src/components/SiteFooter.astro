---
import { site } from "../data/site";
---

<footer>
  <div class="shell inner">
    <p class="tiny">M.A.R.K. — the assistant kernel lineage. PolyForm Noncommercial 1.0.0.</p>
    <a class="tiny link" href={site.repo}>Brightwav3/M.A.R.K.</a>
  </div>
</footer>

<style>
  footer{border-top:1px solid var(--border-subtle);background:var(--surface-card);margin-top:48px}
  .inner{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:20px 0}
  .link{font-family:ui-monospace,"SF Mono",Menlo,monospace}
  @media (max-width:640px){.inner{display:block}.link{display:inline-block;margin-top:8px}}
</style>
