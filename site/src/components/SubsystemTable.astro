---
import StatusPill from "./StatusPill.astro";
import { subsystems, site } from "../data/site";
---

<section class="shell wrap">
  <div class="head">
    <p class="eyebrow">Components and boundaries</p>
    <p class="tiny">Status describes the current composition, not project completion.</p>
  </div>
  <div class="card list">
    {subsystems.map((s) => (
      <a class="row" href={s.href ?? (s.status === "PLANNED" ? site.repo + "#planned-structure" : site.org + "/" + s.name)} class:list={[s.name.includes(" ") && "boundary"]}>
        <span class="name mono">{s.name}</span>
        <span class="owns muted">{s.owns}</span>
        <span class="st"><StatusPill status={s.status} /></span>
      </a>
    ))}
  </div>
  <p class="tiny note">A submodule reference is a pinned commit, not a copy. `assistant-runtime` composes the pinned graph, but each core retains its own ownership and public boundary.</p>
</section>

<style>
  .wrap{padding-top:32px}
  .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .list{overflow:hidden}
  .row{display:grid;grid-template-columns:220px 1fr 120px;gap:20px;align-items:center;padding:12px 16px;color:inherit;text-decoration:none;transition:background 150ms cubic-bezier(.22,1,.36,1)}
  .row + .row{border-top:1px solid var(--border-subtle)}
  .row:hover{background:var(--surface-hover);text-decoration:none}
  .row.boundary{cursor:default}
  .row.boundary:hover{background:var(--surface-card)}
  .name{font-size:13px;color:var(--text-accent)}
  .owns{font-size:13px}
  .st{text-align:right}
  .note{margin-top:12px;max-width:var(--measure)}
  @media (max-width:900px){.head .tiny{display:none}}
  @media (min-width:641px) and (max-width:900px){.row{grid-template-columns:190px 1fr auto;gap:16px}}
  @media (max-width:640px){.row{grid-template-columns:1fr auto;gap:6px}.owns{grid-column:1/-1}}
</style>
